# ─── GoHighLevel Authentication ───────────────────────────────────────────────
#
# Option A — Private Integration Token (PIT)  ← recommended
#   Generate in: GHL sub-account → Settings → Integrations → Private Integrations
#   The token is used directly as a Bearer header (no OAuth exchange needed).
#
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Option B — OAuth 2.0 client_credentials (app / agency installs)
#   Uncomment and fill in if you are using a Marketplace app instead of a PIT.
#
# GHL_CLIENT_ID=your_client_id
# GHL_CLIENT_SECRET=your_client_secret
# GHL_TOKEN_URL=https://services.leadconnectorhq.com/oauth/token

# ─── GoHighLevel Location (sub-account) ───────────────────────────────────────
# Required when creating contacts via the GHL Contacts API.
# Find it in GHL → Settings → Business Info (the ID in the URL).
GHL_LOCATION_ID=your_location_id_here

# ─── API base URL (leave as-is unless using a sandbox) ────────────────────────
GHL_API_BASE_URL=https://services.leadconnectorhq.com

# ─── Express server ────────────────────────────────────────────────────────────
PORT=3000

# ─── Preset payment amount ─────────────────────────────────────────────────────
# Amount in cents: 5000 = $50.00
PRESET_AMOUNT=5000
PRESET_CURRENCY=USD
