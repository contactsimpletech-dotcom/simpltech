# ─── GoHighLevel / Alternative Payments credentials ───────────────────────────
# Obtain these from the Partner Dashboard → API Keys section.
# The client_credentials OAuth flow exchanges these for a bearer token.
GHL_CLIENT_ID=your_client_id_here
GHL_CLIENT_SECRET=your_client_secret_here

# Base URLs (override only if using a sandbox / staging environment)
GHL_TOKEN_URL=https://services.leadconnectorhq.com/oauth/token
GHL_API_BASE_URL=https://services.leadconnectorhq.com

# ─── Express server ────────────────────────────────────────────────────────────
PORT=3000

# ─── Default preset payment amount (in cents, e.g. 5000 = $50.00) ─────────────
PRESET_AMOUNT=5000
PRESET_CURRENCY=USD
