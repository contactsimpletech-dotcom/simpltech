# ─── GoHighLevel Private Integration Token ────────────────────────────────────
# Settings → Integrations → Private Integrations in your GHL sub-account.
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: GHL Location / sub-account ID (needed for Contacts API)
# GHL_LOCATION_ID=your_location_id_here

# ─── Alternative Payments API ─────────────────────────────────────────────────
# Partner Dashboard → Team Preferences → API Keys → Generate API Key
# Used as client_id in OAuth 2.0 Basic Auth: base64(AP_API_KEY:AP_CLIENT_SECRET)
AP_API_KEY=your_ap_api_key_here
AP_CLIENT_SECRET=          # leave blank if not issued

# Switch to demo environment for testing (tokens are isolated per environment):
# AP_BASE_URL=https://public-api.demo.alternativepayments.io
# AP_TOKEN_URL=https://public-api.demo.alternativepayments.io/oauth/token

# ─── Webhook receiver secret (optional) ───────────────────────────────────────
# If set, POST /api/webhooks/receive will verify Authorization: Bearer <secret>
# AP_WEBHOOK_SECRET=your_webhook_secret_here

# ─── QuickBooks Online (optional — skip if not using QBO) ─────────────────────
# Step 1: Create a free app at https://developer.intuit.com
#   App type: Server (not single-page)
#   Redirect URI: https://simpltech-payment.onrender.com/api/qbo/callback
#   Scopes: Accounting
#   Copy the Client ID and Client Secret below.
#
# Step 2: Set QBO_CLIENT_ID + QBO_CLIENT_SECRET in Render, redeploy, then visit:
#   https://simpltech-payment.onrender.com/api/qbo/connect
#   Authorise the app — tokens are saved automatically. No copy-paste needed.
#
QBO_CLIENT_ID=your_qbo_client_id
QBO_CLIENT_SECRET=your_qbo_client_secret

# QBO_REALM_ID and QBO_REFRESH_TOKEN are NO LONGER required as env vars.
# They are saved to the token store automatically after /api/qbo/connect.
# You may still set them here as a seed for the very first deploy if needed.
# QBO_REALM_ID=
# QBO_REFRESH_TOKEN=

# Optional QBO settings:
# QBO_ENVIRONMENT=sandbox          # use 'sandbox' for testing, 'production' for live
# QBO_SERVICE_ITEM_ID=1            # QBO product/service item ID for invoice line (default: 1)

# ─── RingCentral (optional — skip if not using RC) ────────────────────────────
# Step 1: Create an app at https://developers.ringcentral.com
#   Auth: JWT auth flow (server/bot app)
#   Permissions: SMS, ReadMessages, RingOut, CallLog, ReadAccounts (as needed)
#
# Step 2: In your app → Credentials → Create JWT and copy the JWT assertion.
#
RC_CLIENT_ID=your_rc_client_id
RC_CLIENT_SECRET=your_rc_client_secret
RC_JWT_TOKEN=your_rc_jwt_assertion_here

# RC_FROM_NUMBER — E.164 number used as the SMS sender (e.g. +15551234567).
# If omitted, RingCentral uses the account's default number.
# RC_FROM_NUMBER=+15551234567

# Use the RingCentral sandbox for testing (tokens are isolated per environment):
# RC_SERVER_URL=https://platform.devtest.ringcentral.com

# Optional overrides (default to '~' which resolves to the current account/extension):
# RC_ACCOUNT_ID=~
# RC_EXTENSION_ID=~

# If set, POST /api/ringcentral/events will verify Authorization: Bearer <secret>
# RC_WEBHOOK_SECRET=your_rc_webhook_secret_here

# ─── Token store path ─────────────────────────────────────────────────────────
# Where to persist the rotating QBO refresh token (and realm ID).
# Default: /tmp/qbo_tokens.json  (survives process restarts; wiped on redeploy)
# Recommended on Render: mount a persistent disk at /data and set:
# TOKEN_STORE_PATH=/data/qbo_tokens.json

# ─── Render API (optional — keeps Render env var in sync as a backup) ─────────
# The token store is the primary source of truth.
# Set these only if you also want the Render dashboard to reflect the latest token.
# RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Express server ────────────────────────────────────────────────────────────
PORT=3000

# ─── Invoice settings ─────────────────────────────────────────────────────────
PRESET_AMOUNT=7500          # 7500 cents = $75.00
PRESET_CURRENCY=USD
INVOICE_DESCRIPTION=Service fee   # line-item label shown on the invoice
