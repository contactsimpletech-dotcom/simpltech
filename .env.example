# ─── GoHighLevel Private Integration Token ────────────────────────────────────
# Settings → Integrations → Private Integrations in your GHL sub-account.
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: GHL Location / sub-account ID (needed for Contacts API)
# GHL_LOCATION_ID=your_location_id_here

# ─── Alternative Payments API ─────────────────────────────────────────────────
# Partner Dashboard → Team Preferences → API Keys → Generate API Key
# Used as client_id in OAuth 2.0 Basic Auth: base64(AP_API_KEY:AP_CLIENT_SECRET)
AP_API_KEY=your_ap_api_key_here
AP_CLIENT_SECRET=          # leave blank if not issued

# Switch to demo environment for testing (tokens are isolated per environment):
# AP_BASE_URL=https://public-api.demo.alternativepayments.io
# AP_TOKEN_URL=https://public-api.demo.alternativepayments.io/oauth/token

# ─── Webhook receiver secret (optional) ───────────────────────────────────────
# If set, POST /api/webhooks/receive will verify Authorization: Bearer <secret>
# AP_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Express server ────────────────────────────────────────────────────────────
PORT=3000

# ─── Preset payment amount ─────────────────────────────────────────────────────
PRESET_AMOUNT=5000     # 5000 cents = $50.00
PRESET_CURRENCY=USD
